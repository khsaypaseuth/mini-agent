# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_agent"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── MinIO (S3-compatible file storage) ──────────────────────────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="mini-agent"
MINIO_USE_SSL=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-32-chars-min"
JWT_REFRESH_SECRET="change-me-refresh-use-32-chars-min"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App URLs ─────────────────────────────────────────────────────────────────
PORT=3000
APP_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
WEB_APP_URL="http://localhost:3002"

# ─── Payment — Phapay (configure when API keys are available) ─────────────────
# Phapay / PhaJay payment gateway — get secretKey from the PhaJay portal.
# Leave PHAPAY_ENABLED=false to use the mock provider (no real charges).
PHAPAY_ENABLED=false
PHAPAY_SECRET_KEY=""
PHAPAY_USE_TEST_KEY=true
PHAPAY_GENERATE_QR_URL="https://payment-gateway.phajay.co/v1/connect-payment-QR/generateQR"
PHAPAY_SOCKET_URL="https://payment-gateway.phajay.co/"

# ─── WhatsApp Cloud API (configure when token is available) ──────────────────
# WHATSAPP_ENABLED=false uses the mock provider (logs only, no real messages).
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="miniagent-verify-token"
WHATSAPP_API_VERSION="v21.0"

# ─── Maps (configure when key is available) ──────────────────────────────────
GOOGLE_MAPS_API_KEY=""
